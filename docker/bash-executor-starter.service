[Unit]
Description=March7 Bash Executor Starter - Cho phép bot khởi động bash executor
After=network.target
Wants=network.target

[Service]
Type=simple
User=flowerf
WorkingDirectory=/home/flowerf/Projects/march7
ExecStart=/usr/bin/python3 scripts/bash_executor_starter.py
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bash-executor-starter

[Install]
WantedBy=multi-user.target
