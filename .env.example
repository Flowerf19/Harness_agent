# Discord Bot Configuration
DISCORD_LLM_BOT_TOKEN=your_discord_bot_token_here
DISCORD_LLM_BOT_CLIENT_ID=your_discord_client_id_here
SYNC_COMMANDS=0

# LLM Provider Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# Qwen API Configuration
QWEN_API_KEY=your_qwen_api_key_here
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-api-model

# Ollama Configuration
OLLAMA_API_URL=http://localhost:11434
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=Local-ollama-model
# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# LM Studio Configuration
LM_STUDIO_API_URL=http://localhost:1234
LM_STUDIO_MODEL=local-model

# Tool LLM Configuration
TOOL_LLM_ENDPOINT=http://localhost:1234/v1
TOOL_LLM_MODEL=local-model
TOOL_LLM_API_KEY=lm-studio-no-key-needed

# LLM Generation Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=100
LLM_TOP_P=0.9
LLM_TOP_K=40

LLM_HEALTH_CHECK_TIMEOUT=10
LLM_HEALTH_CHECK_RETRIES=3
LLM_HEALTH_CHECK_RETRY_DELAY=1.0

ENABLE_TYPING_SIMULATION=1
TYPING_SPEED_WPM=250
MIN_TYPING_DELAY=0.5
MAX_TYPING_DELAY=8.0
PART_BREAK_DELAY=0.6

# Message Configuration
MAX_MESSAGES=500
LOG_LEVEL=INFO

# LangSmith Tracing Configuration
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=discord-bot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Phoenix/Arize Tracing Configuration
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317