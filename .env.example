# March7 private config
DISCORD_MARCH7_TOKEN=your_march7_discord_bot_token
DISCORD_MARCH7_CLIENT_ID=your_march7_discord_client_id
MARCH7_A2A_PORT=8000
MARCH7_REDIS_DB=0
MARCH7_PERSONA_PATH=twin/march7/personas

# Evernight private config
DISCORD_EVERNIGHT_TOKEN=your_evernight_discord_bot_token
DISCORD_EVERNIGHT_CLIENT_ID=your_evernight_discord_client_id
EVERNIGHT_A2A_PORT=8001
EVERNIGHT_REDIS_DB=1
EVERNIGHT_PERSONA_PATH=twin/evernight/personas
SELF_HEAL_ENABLED=true
SELF_HEAL_INTERVAL=30
SELF_HEAL_TIMEOUT=10
INACTIVITY_SECONDS=1800
POLL_INTERVAL=60

# Agent-to-agent endpoints
EVERNIGHT_A2A_URL=http://evernight:8001
MARCH7_URL=http://march7:8000

# Shared infrastructure
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
CODEBOX_API_URL=http://codebox:8069
BASH_EXECUTOR_URL=http://bash-executor:8374
BASH_EXECUTOR_TIMEOUT=30

# Gateway
GATEWAY_ENABLED_PLATFORMS=discord
DISCORD_GATEWAY_ENABLED=true
SYNC_COMMANDS=0

# LLM provider: gemini, qwen, openai, lms
LLM_PROVIDER=qwen
LLM_MODEL=qwen-max
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TOP_P=0.9
LLM_TOP_K=40

# Generic OpenAI-compatible endpoint
# For 9Router on host from Docker: OPENAI_API_URL=http://host.docker.internal:20128/v1
# For 9Router local: OPENAI_API_URL=http://localhost:20128/v1
OPENAI_API_KEY=dummy-key
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Qwen
QWEN_API_KEY=your_qwen_api_key
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# LM Studio / local OpenAI-compatible endpoint
LM_STUDIO_API_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=local-model
TOOL_LLM_ENDPOINT=http://host.docker.internal:1234/v1
TOOL_LLM_MODEL=local-model
TOOL_LLM_API_KEY=lm-studio-no-key-needed

# Embeddings
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_VECTOR_SIZE=1024

# Tools
TAVILY_API_KEY=your_tavily_api_key
TAVILY_API_URL=https://api.tavily.com
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT=30

# Runtime behavior
LOG_LEVEL=INFO
MAX_MESSAGES=500
ENABLE_TYPING_SIMULATION=1
TYPING_SPEED_WPM=250
MIN_TYPING_DELAY=0.5
MAX_TYPING_DELAY=8.0
PART_BREAK_DELAY=0.6
APPROVAL_AUTO_APPROVE_WITHOUT_CONTEXT=false

# Tracing
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=march7
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
