# Bash Executor Configuration
# Loaded by start_bash_executor.sh and systemd service

# Host to bind to (0.0.0.0 = accept from Docker containers)
BASH_EXECUTOR_HOST=0.0.0.0

# Port (must match BASH_EXECUTOR_URL in .env)
BASH_EXECUTOR_PORT=8374

# Max output chars per stream
BASH_EXECUTOR_MAX_OUTPUT_CHARS=10000

# Max command timeout (seconds)
BASH_EXECUTOR_MAX_TIMEOUT=120

# Allowed Origin header values (comma-separated)
BASH_EXECUTOR_ALLOWED_ORIGINS=march7-bot,http://localhost:8374,http://host.docker.internal:8374
